@using Frontend.Services
@inject AuthState State
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
  <div class="container-fluid"><a class="navbar-brand" href="">Web App</a></div>
</div>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
  <nav class="nav flex-column">
    <div class="nav-item px-3"><NavLink class="nav-link" href="" Match="NavLinkMatch.All">Home</NavLink></div>
    @if (!State.IsLoggedIn)
    {
      <div class="nav-item px-3"><NavLink class="nav-link" href="login">Login</NavLink></div>
      <div class="nav-item px-3"><NavLink class="nav-link" href="register">Register</NavLink></div>
    }
    else
    {
      <div class="nav-item px-3"><NavLink class="nav-link" href="welcome">Welcome</NavLink></div>
      <div class="nav-item px-3"><NavLink class="nav-link" href="lock">Lock Screen</NavLink></div>
      <div class="nav-item px-3"><a class="nav-link" href="" @onclick="DoLogout" @onclick:preventDefault>Logout</a></div>
    }
  </nav>
</div>
@code { void DoLogout() { State.Logout(); Nav.NavigateTo("/login"); } }

