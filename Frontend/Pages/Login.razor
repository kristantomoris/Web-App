@page "/login"
@using Frontend.Services
@inject AuthService Auth
@inject AuthState State
@inject NavigationManager Nav

<div class="d-flex justify-content-center align-items-center" style="min-height:80vh;">
  <div class="card shadow p-4" style="width:100%; max-width:420px; border-radius:16px;">
    <h3 class="text-center mb-1">Selamat Datang</h3>
    <p class="text-center text-muted mb-4">Silakan login untuk melanjutkan</p>

    <label class="form-label">Email</label>
    <input @bind="email" type="email" placeholder="nama@email.com" class="form-control mb-3" />

    <label class="form-label">Password</label>
    <input @bind="password" type="password" placeholder="Masukkan password" class="form-control mb-2" />

    @if (!string.IsNullOrEmpty(pesan))
    {
        <div class="alert @(sukses ? "alert-success" : "alert-danger") py-2">@pesan</div>
    }

    <button @onclick="HandleLogin" class="btn btn-primary w-100 py-2 mt-2" disabled="@loading">
        @(loading ? "Memproses..." : "Login")
    </button>

    <p class="text-center mt-3 mb-0">Belum punya akun? <a href="/register">Daftar di sini</a></p>
  </div>
</div>

@code {
    string email = "", password = "", pesan = "";
    bool sukses = false, loading = false;

    protected override void OnInitialized()
    {
        if (State.IsLoggedIn && !State.IsLocked) Nav.NavigateTo("/welcome");
        if (State.IsLocked) Nav.NavigateTo("/lock");
    }

    async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        { pesan = "Email dan password wajib diisi."; sukses = false; return; }
        loading = true; pesan = "";
        var result = await Auth.Login(email, password);
        loading = false;
        if (result.Success)
        {
            State.Login(result.Nama, result.Email, password);
            Nav.NavigateTo("/welcome");
        }
        else { sukses = false; pesan = result.Message; }
    }
}